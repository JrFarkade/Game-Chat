# GameChat Signaling Server Configuration
PORT=3000
HOST=0.0.0.0

# Optional TURN Relay Configuration (e.g. Metered.ca, Twilio, or self-hosted coturn)
# Required when two friends on different mobile 4G/5G carriers cannot establish a direct P2P connection.
# When provided here, the server securely sends these ICE servers to connected mobile clients.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
